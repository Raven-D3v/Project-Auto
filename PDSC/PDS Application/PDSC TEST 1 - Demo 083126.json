{
  "name": "PDSC TEST 1 - Demo",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const systemLabels = ['UNREAD', 'INBOX', 'CATEGORY_PERSONAL', 'IMPORTANT'];\n\nreturn $input.all().map(item => {\n  const json = item.json;\n\n  // 1. Extract message & thread IDs\n  const messageId = json.id || '';\n  const threadId = json.threadId || '';\n\n  // 2. Parse Sender Name & Email from top-level \"From\"\n  const fromRaw = json.From || '';\n  const emailMatch = fromRaw.match(/<([^>]+)>/);\n  const senderEmail = emailMatch ? emailMatch[1] : fromRaw;\n  const senderName = fromRaw.replace(/<[^>]+>/, '').replace(/\"/g, '').trim() || senderEmail;\n\n  // 3. Parse and format Received Date from top-level \"internalDate\" (ms timestamp)\n  let formattedDate = new Date().toISOString().split('T')[0];\n  if (json.internalDate) {\n    const timestampMs = parseInt(json.internalDate, 10);\n    formattedDate = new Date(timestampMs).toISOString().split('T')[0];\n  }\n\n  // 4. Extract Subject\n  const subject = json.Subject || '';\n\n  // 5. Extract custom labels from top-level \"labels\" array of objects\n  const labelsList = json.labels || [];\n  const customLabels = labelsList\n    .map(labelObj => labelObj.name)\n    .filter(name => !systemLabels.includes(name));\n\n  const primaryLabel = customLabels[0] || 'Unlabeled';\n\n  // 6. Check for attachments\n  const mimeType = json.payload?.mimeType || '';\n  const hasAttachments = mimeType.includes('multipart/mixed') || Boolean(json.attachments);\n\n  return {\n    json: {\n      messageId,\n      threadId,\n      senderName,\n      senderEmail,\n      subject,\n      receivedDate: formattedDate,\n      label: primaryLabel,\n      hasAttachments\n    }\n  };\n});"
      },

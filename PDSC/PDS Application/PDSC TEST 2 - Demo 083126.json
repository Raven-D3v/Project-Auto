      "parameters": {
        "jsCode": "// Access the merged input items\nconst items = $input.all();\n\n// Extract Google Drive link (Item 0)\n// Falls back to webContentLink or empty string if webViewLink isn't available\nconst driveItem = items[0]?.json || {};\nconst driveLink = driveItem.webViewLink || driveItem.webContentLink || \"\";\n\n// Extract Gemini output (Item 1)\nconst geminiItem = items[1]?.json || {};\n\n// Handle both directly mapped properties or raw text string inside parts[0].text\nlet merchant = geminiItem.merchant || \"\";\nlet amount = geminiItem.amount || 0;\nlet currency = geminiItem.currency || \"PHP\";\nlet receiptDate = geminiItem.receipt_date || \"\";\n\n// Fallback JSON string parser in case top-level properties are missing\nif (!merchant && geminiItem.content?.parts?.[0]?.text) {\n  try {\n    const rawText = geminiItem.content.parts[0].text;\n    const cleanJson = rawText.replace(/```json|```/g, '').trim();\n    const parsed = JSON.parse(cleanJson);\n    \n    merchant = parsed.merchant || \"\";\n    amount = parsed.amount || 0;\n    currency = parsed.currency || \"PHP\";\n    receiptDate = parsed.receipt_date || \"\";\n  } catch (e) {\n    // Graceful fallback if parsing fails\n  }\n}\n\n// Return a single consolidated JSON object for Google Sheets\nreturn [\n  {\n    json: {\n      submission_date: new Date().toISOString().split('T')[0],\n      receipt_date: receiptDate,\n      merchant: merchant,\n      amount: amount,\n      currency: currency,\n      drive_photo_link: driveLink\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

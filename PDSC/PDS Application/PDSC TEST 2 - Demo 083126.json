    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  // Extract the raw text containing the markdown JSON block from Gemini\n  const rawText = item.json.content.parts[0].text;\n  \n  // Strip markdown formatting (```json ... ```)\n  const cleanJson = rawText.replace(/```json|```/g, '').trim();\n  \n  // Parse string into a structured JSON object\n  const parsedData = JSON.parse(cleanJson);\n  \n  // Attach parsed properties directly to json output\n  item.json.merchant = parsedData.merchant;\n  item.json.amount = parsedData.amount;\n  item.json.currency = parsedData.currency;\n  item.json.receipt_date = parsedData.receipt_date;\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
